rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner account provisioned without a password; data access requires verified Google sign-in.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.uid == 'b4ebc44b252e4ba7bab758faf37efad8'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /users/{uid}/{collection}/{recordId} {
      allow read, delete: if isOwner(uid)
        && collection in ['jobs','contacts','events','drafts','tasks','notes','appointments','weeklySummaries'];
      allow create, update: if isOwner(uid)
        && collection in ['jobs','contacts','events','drafts','tasks','notes','appointments','weeklySummaries']
        && request.resource.data.id == recordId;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
